# Copia questo file in `.env` per l'uso locale (è già in .gitignore).
# In CI questi valori arrivano dalle GitHub Secrets, non da un file.
#
# Caricalo con:  node --env-file=.env src/index.js

# ─── Provider voli ──────────────────────────────────────────────────────────
# Serve solo la credenziale del provider che usi davvero.
FLIGHT_PROVIDER=serpapi

# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Amadeus Self-Service — https://developers.amadeus.com/my-apps
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test

# ─── Notifiche ──────────────────────────────────────────────────────────────
# Telegram: token da @BotFather, chat id da @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack (alternativa o aggiunta a Telegram)
# SLACK_WEBHOOK_URL=

# ─── Opzionali ──────────────────────────────────────────────────────────────
# HTTP_TIMEOUT_MS=30000
# DEBUG=1
# MOCK_SEED=looking-for-flights
# MOCK_FAILURE_RATE=0
